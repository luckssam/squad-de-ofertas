# ===== Squad de Ofertas =====
# Copie este arquivo para .env e preencha apenas o que você tiver.
# Sem nenhuma chave, o app funciona no modo demonstração.

# --- Comportamento ---
# true  = inclui o catálogo simulado (útil para testar)
# false = usa somente as fontes reais configuradas
DEMO_MODE=true
PORT=8765
REQUEST_TIMEOUT=18
MAX_OFFERS_PER_SOURCE=20
CACHE_TTL=900

# --- Amazon via SerpAPI ---
# true  = habilita Amazon Brasil via SerpAPI (usa a mesma SERPAPI_KEY)
# false = desabilita (usa apenas Google Shopping)
# ATENÇÃO: cada busca consome 1 crédito extra do SerpAPI
AMAZON_VIA_SERPAPI=true

# --- IA (opcional, mas recomendado) ---
# Qualquer endpoint compatível com OpenAI Chat Completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Google Shopping (via SerpAPI) ---
# https://serpapi.com/ — tem plano gratuito limitado
SERPAPI_KEY=

# --- Mercado Livre (API oficial) ---
# https://developers.mercadolivre.com.br/ — crie um app e gere o access token
# Opção A: Token estático (expira em 6h, precisa renovar manual)
MELI_ACCESS_TOKEN=

# Opção B: OAuth 2.0 com refresh automático (recomendado)
# 1. Crie app em https://developers.mercadolivre.com.br/devcenter/
# 2. Configure Redirect URI: http://localhost:8765/auth/meli/callback
# 3. Preencha abaixo e clique em "Conectar Mercado Livre" no app
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:8765/auth/meli/callback
MELI_TOKEN_FILE=data/meli_token.json

# --- Amazon (Product Advertising API 5.0) ---
# Requer conta no Amazon Associates aprovada para PA-API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.com.br
AMAZON_REGION=us-east-1

# --- Shopee (Affiliate Open API — experimental) ---
SHOPEE_APP_ID=
SHOPEE_SECRET=

# --- AliExpress (Affiliate API — experimental) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_SECRET=
ALIEXPRESS_TRACKING_ID=
# ALIEXPRESS_ENDPOINT=https://api-seller.aliexpress.com/openapi/router/rest
